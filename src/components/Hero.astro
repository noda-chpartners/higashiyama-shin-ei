---
import hero from '../assets/video/video.mp4';
---

<section class="hero">
  <video class="hero-video" src={ hero } autoplay loop muted playsinline preload="auto"></video>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .hero {
    position: relative;
    width: 100%;
    min-height: 100dvh;
  }

  .hero-video {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>