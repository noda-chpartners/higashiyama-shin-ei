---
import hero from '../assets/video/video.mp4';
---

<section class="hero">
  <video
    class="hero-video"
    src={hero}
    autoplay
    loop
    muted
    playsinline
    preload="auto"></video>
  <div class="hero-overlay" aria-hidden="true"></div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .hero {
    position: relative;
    width: 100%;
    height: 100dvh;
  }

  .hero-video {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .hero-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.55);
    z-index: -1;
  }
</style>
