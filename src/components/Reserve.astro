---
import { Icon } from 'astro-icon/components';
---

<section class="section reserve" id="reserve">
  <div class="section-title reveal">
    <h2 class="title">Reservation</h2>
  </div>
  <div class="reserve-body reveal" style="--reveal-delay: 0.12s">
    <p class="reserve-lead">Reservations Only</p>
    <div class="reserve-text">
      <p class="reserve-paragraph">
        Higashiyama Shin-ei is operated on a complete reservation basis. So that every
        guest can enjoy a calm and unhurried experience, we kindly ask that you reserve
        your visit in advance.
      </p>
      <p class="reserve-paragraph">
        Reservations can be made online through the sites below, or by phone during
        business hours.
      </p>
    </div>
    <div class="reserve-actions">
      <a
        class="reserve-link btn"
        href="https://savorjapan.com/0031595716"
        target="_blank"
        rel="noopener noreferrer">
        <Icon class="reserve-icon" name="bi:calendar-check" />
        <span>SAVOR JAPAN</span>
      </a>
      <a
        class="reserve-link btn btn-outline"
        href="https://www.pocket-concierge.jp/en/restaurants/245598"
        target="_blank"
        rel="noopener noreferrer">
        <Icon class="reserve-icon" name="bi:calendar-check" />
        <span>Pocket Concierge</span>
      </a>
      <a
        class="reserve-link btn btn-outline"
        href="https://japan-food.guide/restaurants/2234"
        target="_blank"
        rel="noopener noreferrer">
        <Icon class="reserve-icon" name="bi:calendar-check" />
        <span>Japan Food Guide</span>
      </a>
      <a class="reserve-tel btn btn-outline" href="tel:0762552439">
        <Icon class="reserve-icon" name="bi:telephone" />
        <span>076-255-2439</span>
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .reserve-body {
    max-width: 720px;
    margin: 0 auto;
    padding-top: 40px;
  }

  .reserve-lead {
    font-size: clamp(1.125rem, 3vw, 1.5rem);
    line-height: 1.8;
    margin-bottom: 24px;
    text-align: center;
    text-wrap: balance;
  }

  .reserve-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }

  .reserve-paragraph {
    font-size: clamp(0.875rem, 2vw, 1rem);
    line-height: 2;
    text-wrap: pretty;
  }

  .reserve-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 32px;
    border: 1px solid #ffffff;
    background-color: #ffffff;
    color: #111111;
    line-height: 1;
    transition:
      background-color 0.25s,
      color 0.25s,
      transform 0.25s ease;

    &:hover {
      background-color: transparent;
      color: #ffffff;
      transform: translateY(-2px);
    }
  }

  .btn-outline {
    background-color: transparent;
    color: #ffffff;

    &:hover {
      background-color: #ffffff;
      color: #111111;
    }
  }

  .reserve-icon {
    width: 16px;
    height: 16px;
  }

  @include sp {
    .reserve-body {
      padding-top: 24px;
    }

    .reserve-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
