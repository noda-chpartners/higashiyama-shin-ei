---

<section class="section info" id="info">
  <div class="section-title reveal">
    <h2 class="title">Information</h2>
  </div>
  <dl class="info-list reveal" style="--reveal-delay: 0.12s">
    <div class="info-row">
      <dt class="info-term">Name</dt>
      <dd class="info-desc">HIGASHIYAMA-SHIN-EI</dd>
    </div>
    <div class="info-row">
      <dt class="info-term">Address</dt>
      <dd class="info-desc">
        1-12-4 Higashiyama, Kanazawa City, Ishikawa Prefecture 920-0831
      </dd>
    </div>
    <div class="info-row">
      <dt class="info-term">Tel</dt>
      <dd class="info-desc">
        <a class="info-link" href="tel:0762552439">076-255-2439</a>
      </dd>
    </div>
    <div class="info-row">
      <dt class="info-term">Business Hours</dt>
      <dd class="info-desc">18:30 〜 22:00</dd>
    </div>
    <div class="info-row">
      <dt class="info-term">Regular Holiday</dt>
      <dd class="info-desc">Irregular Holidays</dd>
    </div>
    <div class="info-row">
      <dt class="info-term">Reservation</dt>
      <dd class="info-desc">Reservations required</dd>
    </div>
  </dl>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .info-list {
    max-width: 680px;
    margin: 0 auto;
    padding-top: 40px;
  }

  .info-row {
    display: flex;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);

    &:first-child {
      border-top: 1px solid rgba(255, 255, 255, 0.2);
    }
  }

  .info-term {
    flex-shrink: 0;
    width: 160px;
    font-size: clamp(0.875rem, 2vw, 1rem);
    letter-spacing: 0.04em;
  }

  .info-desc {
    flex: 1;
    font-size: clamp(0.875rem, 2vw, 1rem);
    line-height: 1.8;
  }

  .info-link {
    position: relative;
    display: inline-block;
    transition: opacity 0.3s ease;
  }

  .info-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s ease;
  }

  .info-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @include sp {
    .info-list {
      padding-top: 24px;
    }

    .info-row {
      flex-direction: column;
      gap: 6px;
      padding: 14px 0;
    }

    .info-term {
      width: auto;
      font-weight: bold;
    }
  }
</style>
