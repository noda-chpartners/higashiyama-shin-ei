---
import { Image } from 'astro:assets';

import menu01 from '../assets/images/menu01.jpg';
import menu02 from '../assets/images/menu02.jpg';
import menu03 from '../assets/images/menu03.jpg';
import menu04 from '../assets/images/menu04.jpg';
import menu05 from '../assets/images/menu05.jpg';
import menu06 from '../assets/images/menu06.jpg';
import menu07 from '../assets/images/menu07.jpg';
import menu08 from '../assets/images/menu08.jpg';
import menu09 from '../assets/images/menu09.jpg';
import menu010 from '../assets/images/menu010.jpg';

const dishes = [
  { src: menu01, alt: 'Course dish 1' },
  { src: menu02, alt: 'Course dish 2' },
  { src: menu03, alt: 'Course dish 3' },
  { src: menu04, alt: 'Course dish 4' },
  { src: menu05, alt: 'Course dish 5' },
  { src: menu06, alt: 'Course dish 6' },
  { src: menu07, alt: 'Course dish 7' },
  { src: menu08, alt: 'Course dish 8' },
  { src: menu09, alt: 'Course dish 9' },
  { src: menu010, alt: 'Course dish 10' },
];
---

<section class="section course" id="course">
  <div class="section-title reveal">
    <h2 class="title">Course</h2>
  </div>
  <div class="course-body reveal" style="--reveal-delay: 0.12s">
    <p class="course-lead">Chef's Choice Kaiseki Course</p>
    <div class="course-text">
      <p class="course-paragraph">At Higashiyama Shin-ei, we cherish the spirit of tea kaiseki while preparing our chef's choice kaiseki course, using the most appropriate ingredients for the day and the season.</p>
      <p class="course-paragraph">Starting with seafood delivered from Noto, we carefully craft each dish, paying close attention to dashi broth, aroma, presentation, and the lingering aftertaste of the seasonal flavors of the Hokuriku region.</p>
      <p class="course-paragraph">As our menu is not fixed and is instead curated based on the season and our daily market selection, you can enjoy a different culinary experience each time you visit.</p>
    </div>
  </div>
  <ul class="course-gallery">
    {
      dishes.map((dish) => (
        <li class="course-gallery-item">
          <Image class="course-gallery-img" src={dish.src} alt={dish.alt} />
        </li>
      ))
    }
  </ul>
  <script>
    const items = Array.from(
      document.querySelectorAll<HTMLElement>('.course-gallery-item')
    );

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    items.forEach((item, index) => {
      item.style.transitionDelay = `${(index % 5) * 0.08}s`;
      observer.observe(item);
    });

    const images = Array.from(
      document.querySelectorAll<HTMLElement>('.course-gallery-img')
    );

    let ticking = false;

    const updateParallax = () => {
      const viewportHeight = window.innerHeight;
      images.forEach((image, index) => {
        const rect = image.getBoundingClientRect();
        const center = rect.top + rect.height / 2;
        const progress = (center - viewportHeight / 2) / viewportHeight;
        const direction = index % 2 === 0 ? 1 : -1;
        const offset = progress * 28 * direction;
        image.style.transform = `translate3d(0, ${offset}px, 0) scale(1.12)`;
      });
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateParallax);
        ticking = true;
      }
    };

    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    if (!prefersReducedMotion) {
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updateParallax();
    }
  </script>
  <div class="course-price reveal">
    <p class="course-price-note">The dishes shown are examples of what may be included in the course.</p>
    <p class="course-price-amount">
      The price for the chef's selection Kaiseki course is
      <strong>29,700 yen (tax included)</strong>. We prepare each meal using seasonal ingredients, based on what is available at the market that day.
    </p>
    <small class="course-price-annotation"> *Please note that course contents and prices are subject to change depending on market availability. </small>
  </div>
  <div class="course-reserve reveal">
    <p class="course-reserve-text">Reservations required</p>
    <a class="course-reserve-link btn" href="https://savorjapan.com/0031595716" target="_blank">Reserve</a>
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .course-body {
    max-width: 720px;
    margin: 0 auto;
    padding-top: 40px;
  }
  .course-lead {
    font-size: clamp(1.125rem, 3vw, 1.5rem);
    line-height: 1.8;
    margin-bottom: 32px;
    text-align: center;
    text-wrap: balance;
  }
  .course-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .course-paragraph {
    font-size: clamp(0.875rem, 2vw, 1rem);
    line-height: 2;
    text-wrap: pretty;
  }
  .course-gallery {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-top: 48px;
  }
  .course-gallery-item {
    overflow: hidden;
    opacity: 0;
    transform: translateY(48px);
    transition:
      opacity 0.8s ease,
      transform 0.8s ease;
  }
  .course-gallery-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .course-gallery-img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transform: scale(1.12);
    will-change: transform;
    transition: filter 0.4s ease;
  }
  .course-gallery-item:hover .course-gallery-img {
    filter: brightness(1.15);
  }
  .course-price {
    max-width: 720px;
    margin: 48px auto 0;
  }
  .course-price-note {
    font-size: clamp(0.75rem, 2vw, 0.875rem);
    margin-bottom: 20px;
    text-wrap: pretty;
  }
  .course-price-amount {
    font-size: clamp(0.875rem, 2vw, 1rem);
    line-height: 1.9;
    margin-bottom: 12px;
    text-wrap: pretty;
  }
  .course-price-annotation {
    display: block;
    font-size: clamp(0.625rem, 2vw, 0.75rem);
    color: rgba(255, 255, 255, 0.6);
  }
  .course-reserve {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
  }
  .course-reserve-text {
    letter-spacing: 0.1em;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 32px;
    border: 1px solid #ffffff;
    color: #ffffff;
    line-height: 1;
    transition:
      background-color 0.25s,
      color 0.25s,
      transform 0.25s ease;
    &:hover {
      background-color: #ffffff;
      color: #111111;
      transform: translateY(-2px);
    }
  }
  @include tab {
    .course-gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @include sp {
    .course-gallery {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .course-gallery-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .course-gallery-img {
      transform: none;
    }
  }
</style>
